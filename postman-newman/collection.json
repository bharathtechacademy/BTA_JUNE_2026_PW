  "item": [
    {
      "name": "Creating a duplicate repository",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Verify the status code of the duplicate repository request. \r",
              "pm.test(\"Verify Status Code\", function (){\r",
              "    pm.expect(pm.response.code).to.eql(422);\r",
              "})\r",
              "\r",
              "//Verify the status message of the duplicate repository request. \r",
              "pm.test(\"Verify Status message\", function (){\r",
              "    pm.expect(pm.response.status).to.include(\"Unprocessable Entity\");\r",
              "})\r",
              "\r",
              "//Verify the response time of the duplicate repository request. \r",
              "pm.test(\"Verify Response Time\", function (){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "})\r",
              "\r",
              "//Verify the response body of the duplicate repository request. \r",
              "pm.test(\"Verify Response Body\", function (){\r",
              "    pm.expect(pm.response.json().message).to.eql(\"Repository creation failed.\");\r",
              "    pm.expect(pm.response.json().errors[0].message).to.eql(\"name already exists on this account\");\r",
              "})\r",
              "\r",
              "//wait for 2 sec\r",
              "setTimeout(function () {}, 2000);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json",
            "type": "text"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2026-03-10",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "{{TOKEN}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"JmeterRepo\",\r\n    \"description\": \"Sample Duplicate Repo From Postman\",\r\n    \"private\": true\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{BASE_URL}}/user/repos",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "user",
            "repos"
          ]
        }
      },
      "response": []
