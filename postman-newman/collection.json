    {
      "name": "Creating a valid repository",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.environment.set(\"repository\", \"JmeterRepo8\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "//Extract and update Repo name\r",
              "const respBody = pm.response.json();\r",
              "pm.globals.set(\"REPO_NAME\",respBody.name);\r",
              "\r",
              "//Verify the status code of the create repository request. \r",
              "pm.test(\"Verify Status Code\", function (){\r",
              "    pm.expect(pm.response.code).to.eql(201);\r",
              "})\r",
              "\r",
              "//Verify the status message of the create repository request. \r",
              "pm.test(\"Verify Status message\", function (){\r",
              "    pm.expect(pm.response.status).to.include(\"Created\");\r",
              "})\r",
              "\r",
              "//Verify the response time of the create repository request. \r",
              "pm.test(\"Verify Response Time\", function (){\r",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
              "})\r",
              "\r",
              "//Verify the response body of the create repository request. \r",
              "pm.test(\"Verify Response Body\", function (){\r",
              "    pm.expect(pm.response.json().name).to.eql(\"JmeterRepo8\");\r",
              "    pm.expect(pm.response.json().private).to.eql(true);\r",
              "})\r",
              "\r",
              "//wait for 2 sec\r",
              "setTimeout(function () {}, 2000);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json",
            "type": "text"
          },
          {
            "key": "X-GitHub-Api-Version",
            "value": "2026-03-10",
            "type": "text"
          },
